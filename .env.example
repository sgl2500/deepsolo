# DeepSolo runtime configuration
# Copy to .env for the Python backend. Vite variables are read at frontend build time.

# Backend LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_MODEL=glm-4.7

# Backend WebSocket bind address
# Use localhost for local development; use 0.0.0.0 behind a reverse proxy in production.
WS_HOST=localhost
WS_PORT=8765

# Frontend WebSocket endpoint
# Local dev can omit this and use ws://localhost:8765.
# Production example: wss://signal.deepsolo.cn/ws
VITE_DEEPSOLO_WS_URL=

# Production builds disable these by default. Set to 1 only for trusted demos/admin builds.
VITE_DEEPSOLO_ENABLE_DEV_TOOLS=0
VITE_DEEPSOLO_ENABLE_DEMO_AUTH=0
